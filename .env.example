# ── Mercado Livre (obter em developers.mercadolivre.com.br) ──
ML_APP_ID=SEU_CLIENT_ID_AQUI
ML_SECRET=SEU_CLIENT_SECRET_AQUI

# URL de callback — depois do primeiro deploy na Vercel, trocar pelo domínio real
ML_REDIRECT=https://rose-artesanatos-sistema-enwk.vercel.app/api/auth/callback

# ── Supabase (Project Settings > API) ──
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# ── Acesso ao sistema ──
# Senha compartilhada da equipe para entrar no sistema (defina uma forte).
APP_PASSWORD=DEFINA_UMA_SENHA_FORTE
# Opcional: segredo dedicado para assinar os tokens de sessão. Se não definir,
# reaproveita a SUPABASE_SERVICE_ROLE_KEY automaticamente.
# AUTH_SECRET=
